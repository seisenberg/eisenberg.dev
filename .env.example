# eisenmail configuration reference. Nothing here is a real secret.
# Local development needs none of this: `npm run dev` sets its own values.
# In AWS these are set by infra/app.yml; see docs/SETUP.md.

# ---- both lambdas: database ---------------------------------------------------------------
POSTGRES_DB_HOST=127.0.0.1          # with a tunnel: the address of postgres as seen FROM the tunnel host
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=emails
POSTGRES_DB_USER=eisenmail
POSTGRES_DB_PASSWORD_SSM=/eisenmail/db_password   # SSM SecureString (or POSTGRES_DB_PASSWORD=<value> for local use)
# POSTGRES_DB_SSLMODE=verify-full   # direct connections only; default verify-full in production

# ---- both lambdas: optional ssh tunnel to the database host --------------------------------
# SSH_TUNNEL_HOST=data.example.com
# SSH_TUNNEL_PORT=22
# SSH_TUNNEL_USER=tunnel
# SSH_TUNNEL_KEY_SSM=/eisenmail/tunnel_ed25519      # SSM SecureString holding the private key
# SSH_TUNNEL_HOST_KEY=ssh-ed25519 AAAA...           # REQUIRED with a tunnel: ssh-keyscan -t ed25519 <host>

# ---- both lambdas: push notifications (optional; generate with `npm run push:keys`) ---------
# VAPID_PRIVATE_KEY_SSM=/eisenmail/vapid_private_key   # SSM SecureString (or VAPID_PRIVATE_KEY=<value>)
# VAPID_SUBJECT=mailto:postmaster@eisenberg.dev        # contact shown to the push services

# ---- web lambda (node) ---------------------------------------------------------------------
NODE_ENV=production
PUBLIC_ORIGIN=https://eisenberg.dev
MAIL_DOMAINS=eisenberg.dev,example-llc.com          # domains you may send from (SES verified)
DEFAULT_FROM=sam@eisenberg.dev
TRUSTED_PROXY_HOPS=1                                # 1 = function URL only, 2 = CloudFront in front
# SES_REGION=us-east-1
MAIL_BUCKET=                                        # bucket SES writes raw mail to (cleanup on permanent delete)
MAIL_PREFIX=email-inbox/
FILES_BUCKET=                                       # private file drop
FILES_PREFIX=drop/
PUBLIC_FILES_BUCKET=                                # separate bucket for files marked public (recommended)
PUBLIC_FILES_PREFIX=public/
# VAPID_PUBLIC_KEY=                                  # the public half; sent to browsers
# SESSION_TTL_HOURS=720                              # sliding: counted from the last use

# ---- inbox lambda (python) -----------------------------------------------------------------
FORWARD_TO=you@private-mailbox.example              # where forwards go
# OWNER_ADDRESSES=you@private-mailbox.example       # who may use the reply relay (default FORWARD_TO)
