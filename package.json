{
  "name": "eisenmail",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json",
    "start": "node build/server/main.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "user:set": "tsx scripts/set-user.ts",
    "db:schema": "tsx scripts/apply-schema.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "test:e2e": "npm run build:ui && tsx --test --test-timeout=120000 --test-concurrency=1 test/e2e/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/client-sesv2": "^3.1166.0",
    "@aws-sdk/client-ssm": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.7.1",
    "@simplewebauthn/server": "^14.1.0",
    "koa": "^3.3.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/koa": "^3.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "embedded-postgres": "^18.6.0-beta.19",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "puppeteer-core": "^25.17.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.21.0",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.6.0-beta.19": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-arm64@18.6.0-beta.19": true,
    "@embedded-postgres/darwin-x64@18.6.0-beta.19": true
  }
}
