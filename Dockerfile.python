# eisenmail inbound Lambda: SES receipt rule -> S3 -> py/inbox.lambda_handler
#
# Build from the repository root:
#   docker build -f Dockerfile.python -t eisenmail-python --build-arg BUILD_TAG=$(git rev-parse --short HEAD) .
#
# Everything is configured through environment variables (see py/config.py). No secrets are
# baked into the image: the SSH tunnel key is read from SSM at runtime (SSH_TUNNEL_KEY_SSM).
# uv installs the dependencies; a stage of its own, so that Dependabot sees the version.
FROM ghcr.io/astral-sh/uv:0.12.23 AS uv

# ---- build: the exact versions of py/uv.lock, into a virtual environment ----------------------
FROM python:3.14-slim-trixie AS build
COPY --from=uv /uv /usr/local/bin/uv
# Use the interpreter of this image (never download another one), copy files instead of linking
# them into a cache that is not shipped, and compile to bytecode now rather than at cold start.
ENV UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/eisenmail/venv
WORKDIR /opt/eisenmail/py
# All compiled dependencies ship wheels (awslambdaric, psycopg[binary], cryptography, aiohttp and
# friends via pywebpush); http-ece is a pure-python source package that uv builds itself, so no
# compiler, python3-dev or libpq-dev is needed. --locked fails the build if uv.lock does not match
# pyproject.toml; --no-dev leaves the test tools out.
COPY py/pyproject.toml py/uv.lock ./
RUN uv sync --locked --no-dev --no-cache

# ---- the image that runs in Lambda: same base, the environment, the modules. No uv, no pip cache.
FROM python:3.14-slim-trixie AS python_runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    PATH="/opt/eisenmail/venv/bin:$PATH"

WORKDIR /opt/eisenmail/py
COPY --from=build /opt/eisenmail/venv /opt/eisenmail/venv

# Only the runtime modules: no tests, no key material.
COPY py/config.py py/db.py py/relay.py py/push.py py/reconcile.py py/inbox.py ./

# --build-arg BUILD_TAG=GIT_SHA
ARG BUILD_TAG=pybot
ENV IMAGE_TAG=$BUILD_TAG

ENTRYPOINT ["/opt/eisenmail/venv/bin/python", "-m", "awslambdaric"]
CMD ["inbox.lambda_handler"]
