# eisenmail inbound Lambda: SES receipt rule -> S3 -> py/inbox.lambda_handler
#
# Build from the repository root:
#   docker build -f Dockerfile.python -t eisenmail-python --build-arg BUILD_TAG=$(git rev-parse --short HEAD) .
#
# Everything is configured through environment variables (see py/config.py). No secrets are
# baked into the image: the SSH tunnel key is read from SSM at runtime (SSH_TUNNEL_KEY_SSM).
FROM python:3.14-slim-trixie AS python_runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANG=C.UTF-8

WORKDIR /opt/eisenmail/py

# All compiled dependencies ship manylinux wheels (awslambdaric, psycopg[binary], cryptography,
# aiohttp and friends via pywebpush); http-ece is a pure-python sdist that pip builds itself,
# so no compiler, python3-dev or libpq-dev is needed.
COPY py/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Only the runtime modules: no tests, no virtualenv, no key material.
COPY py/config.py py/db.py py/relay.py py/push.py py/reconcile.py py/inbox.py ./

# --build-arg BUILD_TAG=GIT_SHA
ARG BUILD_TAG=pybot
ENV IMAGE_TAG=$BUILD_TAG

ENTRYPOINT ["/usr/local/bin/python3", "-m", "awslambdaric"]
CMD ["inbox.lambda_handler"]
